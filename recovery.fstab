# Android fstab file.
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK

#<src>                  <mnt_point>         <type>    <mnt_flags and options>                               <fs_mgr_flags>
/dev/block/platform/11120000.ufs/by-name/OMR           /metadata       ext4        nosuid,nodev,noatime,discard                        wait,check,formattable,metadata_csum
/dev/block/platform/11120000.ufs/by-name/USERDATA	/data	f2fs	noatime,nosuid,nodev,discard,fsync_mode=nobarrier,reserve_root=32768,resgid=5678	wait,check,quota,reservedsize=128M,checkpoint=fs
/dev/block/platform/11120000.ufs/by-name/USERDATA	/data	ext4	noatime,nosuid,nodev,noauto_da_alloc,discard,journal_checksum,data=ordered	wait,check,quota,reservedsize=128M,checkpoint=fs

# ADD FOR GOTA
/dev/block/platform/11120000.ufs/by-name/MISC           /misc       emmc    defaults                                                                                                     defaults
